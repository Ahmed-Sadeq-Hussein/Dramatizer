  "lines": {
    "validation": [
      {
        "line_id": "long-02",
        "length": "long",
        "text": "I have kept your secret for almost ten years, but I am tired, and I will not lie to them again."
      },
      {
        "line_id": "long-05",
        "length": "long",
        "text": "We walked along the river until the road disappeared, and then we sat down on the stones and waited for morning."
      },
      {
        "line_id": "long-06",
        "length": "long",
        "text": "Before you open that box, I need you to understand that nothing in your life will ever be the same."
      },
      {
        "line_id": "medium-02",
        "length": "medium",
        "text": "She folded the note twice and slipped it under the door."
      },
      {
        "line_id": "medium-05",
        "length": "medium",
        "text": "Tell your brother the boat leaves before the sun comes up."
      },
      {
        "line_id": "medium-06",
        "length": "medium",
        "text": "Do you really think anyone in this town will believe you?"
      },
      {
        "line_id": "medium-07",
        "length": "medium",
        "text": "He laughed so hard that the whole kitchen went quiet."
      },
      {
        "line_id": "short-01",
        "length": "short",
        "text": "Nobody told me you were coming."
      },
      {
        "line_id": "short-04",
        "length": "short",
        "text": "We have to leave tonight."
      },
      {
        "line_id": "short-06",
        "length": "short",
        "text": "You promised you would wait for me."
      }
    ],
    "test": [
      {
        "line_id": "long-01",
        "length": "long",
        "text": "By the time the doctor arrived, the fire had burned down to ash and the children had fallen asleep by the window."
      },
      {
        "line_id": "long-03",
        "length": "long",
        "text": "When the music finally stopped, everyone turned to look at the old man waiting alone beside the empty stage."
      },
      {
        "line_id": "long-04",
        "length": "long",
        "text": "You can shout at me all you like, but the money is gone and shouting will not bring it back."
      },
      {
        "line_id": "medium-01",
        "length": "medium",
        "text": "The lights went out just as the train reached the bridge."
      },
      {
        "line_id": "medium-03",
        "length": "medium",
        "text": "If you walk away now, there is no coming back."
      },
      {
        "line_id": "medium-04",
        "length": "medium",
        "text": "I can still hear the rain on the roof of that old house."
      },
      {
        "line_id": "medium-08",
        "length": "medium",
        "text": "All I wanted was one honest answer from somebody in this family."
      },
      {
        "line_id": "short-02",
        "length": "short",
        "text": "Give me back that letter."
      },
      {
        "line_id": "short-03",
        "length": "short",
        "text": "Why is the door still open?"
      },
      {
        "line_id": "short-05",
        "length": "short",
        "text": "I never asked for any of this."
      }
    ]
  }
