    {"id": "s08", "kind": "small", "question": "Which dataset's genomes got the best average score?", "tool": "query_scores",
     "truth": {"tool": "query_scores", "arguments": {"group_by": "dataset", "sort": "mean"}, "must": ["groups.0.dataset"]}},
    {"id": "s09", "kind": "small", "question": "What is the average score of genomes with two genes?", "tool": "query_scores",
