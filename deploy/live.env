# deploy/live.env | What the live site sets on top of deploy/container.env (docker run --env-file container.env
# --env-file live.env: a later file wins). Paths and switches only, never a secret.
#
# Both release.py (the settings hash in the release record) and blue_green.py (the container) read the same files:
#   python deploy/release.py v6 --image sha256:... --env deploy/container.env --env deploy/live.env ...
#   .\deploy\live.ps1 release sha256:... --release ...      # live.ps1 passes both --env files itself

# The team's recorded and uploaded voices: deploy/live.ps1 mounts "D:/voice data/Voices" here (--team-voices)
VOICES_DIR=/team-voices
