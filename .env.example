# Authored by Ahmed Hussein
# All rights of ownership belong to AHJN and MING .
# Example settings: copy this file to .env and edit it. Never commit .env: every person
# keeps their own copy, because paths, hardware and keys differ per machine.
# The code reads these values; nothing here should be written in the code.

# --- Text-to-speech model -------------------------------------------------
# Which voice cloning backend to use: cosyvoice3 or custom (Your model of choice)
TTS_BACKEND=cosyvoice3

# The voice cloning model's code: a checkout of the CosyVoice repository
# (github.com/FunAudioLLM/CosyVoice), which runs CosyVoice 3
# Edit this for your personal directory
VOICE_MODEL_DIR=D:/path/to/CosyVoice3

# The CosyVoice 3 weights, Fun-CosyVoice3-0.5B-2512, downloaded from
# Hugging Face or ModelScope into pretrained_models/ of the checkout
# Edit this for your personal directory
COSYVOICE_MODEL_DIR=D:/path/to/CosyVoice3/pretrained_models/Fun-CosyVoice3-0.5B

# cuda for an NVIDIA GPU, cpu otherwise
DEVICE=cuda

# --- Data -----------------------------------------------------------------
# One sub-folder per voice, each with reference.wav and reference.txt
VOICES_DIR=D:/path/to/Voices
# Which of those folders show under "Custom voices" in the V4 page, comma separated
# CUSTOM_VOICES=voice_one,voice_two

# The voice library: one sub-folder per dataset (see "Voice library.txt")
# Edit this for your personal directory
VOICE_LIBRARY_DIR=D:/path/to/Voices library
CREMA_D_FOLDER=CREMA-D
VCTK_FOLDER=VCTK
LIBRITTS_R_FOLDER=LibriTTS-R

# Where exploration runs and the winning genomes are stored
RUNS_DIR=output/exploration
HISTORY_PATH=history/voices.json

# --- Measurements ---------------------------------------------------------
# The models that score a recording (loaded by model.py):
# WER_MODEL: the speech recogniser for the word error rate, whisper-<size>
#   (whisper-tiny, whisper-base, whisper-small, whisper-medium)
WER_MODEL=whisper-base
# SIMILARITY_MODEL: how alike two voices are. Supported: resemblyzer
SIMILARITY_MODEL=resemblyzer
# PERQ_MODEL: perceptual quality of one recording. Supported: squim
PERQ_MODEL=squim

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# LLM_LIBRARY_DIR: one sub-folder per downloaded LLM (emphasis.py)
LLM_LIBRARY_DIR=D:/path/to/LLM library
# EMPHASIS_MODEL: which of them scores word emphasis
EMPHASIS_MODEL=Qwen3-4B


# The password of Voice_model_example_UI_V4.py (at least 12 characters).
# Leave it out and a strong one is made and saved in .env on the first start.
# UI_PASSWORD=
