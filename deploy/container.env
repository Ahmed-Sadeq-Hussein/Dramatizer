# deploy/container.env | The settings inside the container (docker run --env-file deploy/container.env).
# Committed on purpose: it holds ONLY paths and switches, never a password, key or token. Secrets go in a second
# env file outside the repository (D:/Dramatizer secrets/secrets.env), passed with another --env-file.
# The host's .env keeps its Windows paths (D:/...); these are the same places as seen from inside the container.

# The server listens on every interface INSIDE the container; `-p 127.0.0.1:5005:5005` still keeps it to this
# computer (and the tunnel), as before.
API_HOST=0.0.0.0
API_PORT=5005
DEVICE=cuda

# Code baked into the image
VOICE_MODEL_DIR=/opt/CosyVoice

# Mounted read-only: the model store (Milestone 4, problem 2). /version reads its models.json.
MODELS_DIR=/models
# Load CosyVoice at start-up: /ready answers 200 only once it is loaded (step 4)
PRELOAD_VOICE_MODEL=1
COSYVOICE_MODEL_DIR=/models/Fun-CosyVoice3-0.5B
LLM_LIBRARY_DIR=/models/llm
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
XDG_CACHE_HOME=/models/cache
TORCH_HOME=/models/cache/torch
# CosyVoice's text normaliser: from the store, never fetched from ModelScope at load (which now refuses anonymous
# requests; without these files CosyVoice silently renders with no text normalisation)
WETEXT_DIR=/models/cache/wetext

# Mounted read-only: the voice pack (python main_backend.py voice-pack pull REVISION), not the 24 GB library.
VOICE_PACK_DIR=/voices
VOICE_LIBRARY_DIR=/voices
# The team's own recorded voices: empty until a folder is mounted for them (the API then lists none)
VOICES_DIR=

# Mounted read-write: renders, searches, charts and measurements. VCTK clips taken out of their parquet files go
# there too, because the code folder (/app) belongs to root and the server runs as an ordinary user.
# librosa (CosyVoice, Whisper) compiles with numba, which caches next to the package by default: in /opt/venv,
# which the server's user cannot write. Without this CosyVoice fails to load ("no locator available").
NUMBA_CACHE_DIR=/tmp/numba
MPLCONFIGDIR=/tmp/matplotlib

OUTPUT_DIR=/output
IMPORT_DIR=/output/imported_voices
MEASUREMENTS_DIR=/output/measurements

# The GPU queue: at most 4 jobs queued or running for everyone together (Milestone 4, step 7: about a minute's
# wait at 13 s a render; at 12, an accepted render waited up to 4 minutes)
MAX_QUEUE=4

# The chatbot runs in its own Python 3.11 environment (newer torch and transformers than CosyVoice allows), which
# this image does not have yet: off, and the site says so.
CHATBOT_PYTHON=
