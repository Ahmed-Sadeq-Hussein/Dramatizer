    {"id": "s11", "kind": "small", "question": "What did Ash score the plain line of CREMA-D/1014?", "tool": "query_scores",
     "truth": {"tool": "query_scores", "arguments": {"listener": "Ash", "voice": "CREMA-D/1014", "clip": "plain"}, "must": ["rows.0.score"]}},
    {"id": "s12", "kind": "small", "question": "Which genome with a sigh got the highest score?", "tool": "query_scores",
     "truth": {"tool": "query_scores", "arguments": {"gene_type": "sigh", "sort": "score", "limit": 50}, "must": ["rows.0.score"], "any_tied": "voice"}},
    {"id": "s13", "kind": "small", "question": "Who has rated genomes so far?", "tool": "query_scores",
