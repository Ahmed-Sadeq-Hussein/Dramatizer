    {"id": "s04", "kind": "small", "question": "What is Julius's average score for genomes?", "tool": "query_scores",
     "truth": {"tool": "query_scores", "arguments": {"listener": "Julius", "group_by": "listener"}, "must": ["groups.0.mean"]}},
    {"id": "s05", "kind": "small", "question": "Which gene type beats the plain line most often?", "tool": "query_scores",
     "truth": {"tool": "query_scores", "arguments": {"group_by": "gene_type", "sort": "beat_plain"}, "must": ["groups.0.gene_type"]}},
    {"id": "s06", "kind": "small", "question": "Which gene type has the worst average score?", "tool": "query_scores",
